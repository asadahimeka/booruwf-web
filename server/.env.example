# booruwf-server 环境变量示例
# 复制为 server/.env 后按需修改；完整说明见 server/README.md
# 优先级：CLI / shell 环境变量 > 本文件（Bun/Deno 自动加载与本加载器均不覆盖已有变量）

# --- 基础 ---
# 监听端口
PORT=8787
# 上游 HTTP 代理（danbooru 等被出口 403 的站点需要；留空直连）
# UPSTREAM_PROXY=http://127.0.0.1:7890
# TLS 指纹封锁回退域名（Node 下改走 curl 子进程；设为空串关闭回退）
# CURL_FALLBACK_HOSTS=danbooru.donmai.us,aibooru.online,e621.net,e926.net
# /img 放开到任意合法公网 https 域（0 = 回到纯白名单模式）
# IMG_ALLOW_ANY_HOST=1

# --- 限流 ---
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# 信任反向代理头（仅在自家反代之后开启，否则客户端可伪造）
# TRUST_PROXY=false
# Cloudflare 部署时开启（信任 cf-connecting-ip）
# TRUST_CLOUDFLARE=false

# --- 代理端点拦截（UA / 来源校验） ---
# 来源域白名单，逗号分隔，支持 *.example.com 通配；留空不校验（本地部署）
# ACCEPT_DOMAINS=booru.example.com
# 额外 UA 关键词黑名单，逗号分隔
# UA_BLACKLIST=

# --- SSRF 防护 ---
# 额外域白/黑名单，逗号分隔，支持 *. 通配
# PROXY_ALLOW_DOMAINS=
# PROXY_BLOCK_DOMAINS=
# 1 = 关闭内置 IP-echo 服务黑名单
# PROXY_ALLOW_IP_ECHO=0
# 0 = 关闭 DNS 解析校验（上游代理解析 DNS / 本地 DNS 异常场景）
# SSRF_DNS_CHECK=1

# --- 并发去重（GET /proxy） ---
# 去重队列容量上限
# DEDUPER_MAX=500
# 可共享响应体字节上限（超限不缓冲，各请求直连透传）
# DEDUP_BODY_MAX=5242880
