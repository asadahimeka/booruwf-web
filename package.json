{
  "name": "booruwf",
  "type": "module",
  "version": "0.39.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "description": "Booru sites masonry browsing mode.",
  "author": "asadahimeka",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src --ext .ts,.vue",
    "release": "node scripts/release.mjs",
    "server": "pnpm -C server dev",
    "server:start": "pnpm -C server start",
    "server:smoke": "pnpm -C server smoke",
    "check": "vue-tsc --noEmit --skipLibCheck",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "preinstall": "npx -y only-allow pnpm"
  },
  "dependencies": {
    "@fancyapps/ui": "5.0.36",
    "@himeka/booru": "workspace:2.7.7",
    "@himeka/masonry-css": "workspace:1.0.3",
    "@himeka/masonry-true": "workspace:1.0.5",
    "@himeka/virtual-waterfall": "workspace:1.0.8",
    "@vueuse/core": "11.0.3",
    "date-fns": "3.6.0",
    "dplayer": "1.27.1",
    "vue": "2.7.16",
    "vue-i18n": "8.28.2",
    "vuetify": "2.7.2"
  },
  "devDependencies": {
    "@antfu/eslint-config-vue": "0.27.0",
    "@himeka/release": "workspace:0.0.1",
    "@mdi/js": "7.4.47",
    "@playwright/test": "1.65.1",
    "@types/node": "20.10.6",
    "@vitejs/plugin-vue2": "2.3.3",
    "eslint": "8.33.0",
    "playwright": "1.65.1",
    "typescript": "4.9.5",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vue-template-compiler": "2.7.16",
    "vue-tsc": "1.8.27"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
